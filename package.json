{
  "name": "demo",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "gen:build-info": "node scripts/generate-build-info.mjs",
    "postinstall": "node scripts/generate-build-info.mjs",
    "start": "pnpm gen:build-info && ng serve",
    "build": "pnpm gen:build-info && ng build",
    "watch": "pnpm gen:build-info && ng build --watch --configuration development",
    "tauri": "tauri",
    "test": "pnpm gen:build-info && ng test"
  },
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.3.0",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  }
}
