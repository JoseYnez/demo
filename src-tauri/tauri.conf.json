{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "demo",
  "version": "0.1.0",
  "identifier": "com.luisyanez.demo",
  "build": {
    "beforeDevCommand": "pnpm start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/demo/browser"
  },
  "app": {
    "windows": [
      {
        "title": "demo",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 520,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'sha256-ag88LQMradixz2/Rm32exumd/Rbe/0UkawP8VFjuJc8='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
